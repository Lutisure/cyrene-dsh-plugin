{
  "name": "@lutisure/dsh-theme-cyrene",
  "version": "0.17.2",
  "private": false,
  "type": "module",
  "description": "昔涟主题 · Cyrene — 淡粉柔光配色 + 半透明壁纸 + 环境流萤粒子 + 背景音乐 + 打字音效（DeepSeek Harness 客户端主题插件）",
  "license": "MIT",
  "author": {
    "name": "Lutisure"
  },
  "homepage": "https://github.com/Lutisure/cyrene-dsh-plugin/tree/main/dsh-theme-cyrene",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lutisure/cyrene-dsh-plugin.git",
    "directory": "dsh-theme-cyrene"
  },
  "bugs": {
    "url": "https://github.com/Lutisure/cyrene-dsh-plugin/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "dsh.plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:clean": "node build.mjs --clean",
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "check:identity": "node tools/check-identity.mjs",
    "check:bundle": "node tools/check-bundle.mjs",
    "probe:panel": "node tools/probe-panel.mjs",
    "check:palette": "node tools/check-contrast.mjs",
    "preview:playlist": "python tools/render-playlist-window.py",
    "avatar": "python tools/crop-avatar.py --write",
    "boot": "python tools/render-boot.py --write --quality 86 --alpha-quality 80",
    "boot:check": "python tools/render-boot.py",
    "harvest": "python tools/harvest-assets.py --write",
    "harvest:check": "python tools/harvest-assets.py",
    "emotes": "python tools/build-emotes.py --write",
    "assets": "python tools/harvest-assets.py --write",
    "check-live": "node tools/check-live.mjs",
    "check:visual": "node tools/check-visual.mjs",
    "check:panel": "node tools/check-panel-contrast.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "ui",
    "cordis"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    }
  }
}
